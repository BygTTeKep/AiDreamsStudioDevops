# Режим http. ${MAIN_DOMAIN} и ${PARTNERS_DOMAIN} подставляются из env при старте.

server {
  listen 80;
  server_name ${MAIN_DOMAIN} www.${MAIN_DOMAIN};

  include /etc/nginx/snippets/acme.conf;

  location / {
    set $upstream http://front:80;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass $upstream;
  }
}

server {
  listen 80;
  server_name ${PARTNERS_DOMAIN};

  include /etc/nginx/snippets/acme.conf;

  location / {
    set $upstream http://partners:80;
    include /etc/nginx/snippets/proxy.conf;
    proxy_pass $upstream;
  }
}
