# Режим http: без TLS. Файл перекрывает default.conf образа nginx.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# фото товара: до 10 файлов по 10 МБ — как в nginx фронтов
client_max_body_size 110m;
server_tokens off;

# неизвестные хосты и обращения по IP — закрыть соединение
server {
  listen 80 default_server;
  server_name _;

  include /etc/nginx/snippets/acme.conf;
  location = /healthz { access_log off; return 200 "ok\n"; }
  location / { return 444; }
}
